# Public Formspree form ID (safe in static bundle, e.g. xabcdefg).
# Leave empty until the Formspree form and inbox anggavb8@gmail.com are verified;
# when empty, the contact form automatically renders the explicit unconfigured state.
PUBLIC_FORMSPREE_FORM_ID=

# Optional public Cloudflare Turnstile site key for Referer-independent bot protection.
# Store the Turnstile SECRET key ONLY inside the Formspree dashboard, never here.
PUBLIC_TURNSTILE_SITE_KEY=

# Optional opt-in public phone number. Omitted by default to prevent public scraping.
PUBLIC_CONTACT_PHONE=

# Optional server/build-only GitHub token for higher build-time REST API quota (e.g. in CI).
# NEVER prefix with PUBLIC_. Never bundled into dist/.
GITHUB_TOKEN=
