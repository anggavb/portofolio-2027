---
import type { PortfolioDictionary } from '../data/portfolio';

interface Props {
  dict: PortfolioDictionary;
}

const { dict } = Astro.props;
const hasCertifications = dict.education.certifications.length > 0;
const hasRecommendations = dict.education.recommendations.length > 0;
---

<section id="education" aria-labelledby="education-heading" class="swiss-section py-12 sm:py-16">
  <div class="swiss-container">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-3">
        <p class="m-0 font-mono-tech text-xs font-semibold tracking-wider text-[var(--text-muted)]">
          {dict.education.sectionIndex}
        </p>
        <h2
          id="education-heading"
          class="m-0 mt-2 text-[clamp(1.5rem,2.5vw,2.15rem)] font-bold leading-[1.2] tracking-[-0.02em] text-[var(--text-primary)]"
        >
          {dict.education.title}
        </h2>
        <p class="m-0 mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
          {dict.education.subtitle}
        </p>
      </div>

      <div class="lg:col-span-9">
        <div class="grid grid-cols-1 gap-4">
          {
            dict.education.items.map((edu) => (
              <article class="swiss-card p-5">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="m-0 text-lg font-bold text-[var(--text-primary)]">
                    {edu.institution}
                  </h3>
                  <span class="font-mono-tech text-xs font-semibold text-[var(--text-muted)]">
                    {edu.period}
                  </span>
                </div>
                <p class="m-0 mt-1 text-sm font-semibold text-[var(--accent-primary)]">
                  {edu.degree}
                </p>
                <p class="m-0 mt-0.5 font-mono-tech text-xs text-[var(--text-muted)]">
                  {edu.location}
                </p>
                <ul class="m-0 mt-3 flex list-disc flex-col gap-1.5 pl-5 text-sm leading-relaxed text-[var(--text-secondary)]">
                  {edu.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>

        {hasCertifications && (
          <div id="certifications" class="mt-10 border-t border-[var(--border-grid)] pt-8">
            <h3 class="m-0 text-lg font-bold text-[var(--text-primary)]">
              {dict.education.certificationsTitle}
            </h3>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
              {dict.education.certifications.map((cert) => (
                <article class="swiss-card p-4">
                  <h4 class="m-0 text-base font-semibold text-[var(--text-primary)]">
                    {cert.name}
                  </h4>
                  <p class="m-0 mt-1 font-mono-tech text-xs text-[var(--text-muted)]">
                    {cert.issuer} // {cert.issuedDate}
                  </p>
                  {cert.credentialUrl && (
                    <a
                      href={cert.credentialUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-2 inline-flex min-h-[44px] items-center font-mono-tech text-xs font-semibold text-[var(--accent-primary)] underline"
                    >
                      Verify Credential -&gt;
                    </a>
                  )}
                </article>
              ))}
            </div>
          </div>
        )}

        {hasRecommendations && (
          <div id="recommendations" class="mt-10 border-t border-[var(--border-grid)] pt-8">
            <h3 class="m-0 text-lg font-bold text-[var(--text-primary)]">
              {dict.education.recommendationsTitle}
            </h3>
            <div class="mt-4 grid grid-cols-1 gap-4">
              {dict.education.recommendations.map((rec) => (
                <figure class="m-0 swiss-card p-5">
                  <blockquote class="m-0 text-sm leading-relaxed text-[var(--text-secondary)]">
                    <p class="m-0">"{rec.quote}"</p>
                  </blockquote>
                  <figcaption class="mt-3 font-mono-tech text-xs text-[var(--text-muted)]">
                    <strong class="text-[var(--text-primary)]">{rec.author}</strong> : {rec.roleAndCompany} ({rec.relationship})
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
