---
import type { PortfolioDictionary } from '../data/portfolio';

interface Props {
  dict: PortfolioDictionary;
}

const { dict } = Astro.props;
---

<section id="experience" aria-labelledby="experience-heading" class="swiss-section py-12 sm:py-16">
  <div class="swiss-container">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-3">
        <p class="m-0 font-mono-tech text-xs font-semibold tracking-wider text-[var(--text-muted)]">
          {dict.experience.sectionIndex}
        </p>
        <h2
          id="experience-heading"
          class="m-0 mt-2 text-[clamp(1.5rem,2.5vw,2.15rem)] font-bold leading-[1.2] tracking-[-0.02em] text-[var(--text-primary)]"
        >
          {dict.experience.title}
        </h2>
        <p class="m-0 mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
          {dict.experience.subtitle}
        </p>
      </div>

      <div class="lg:col-span-9">
        <ol class="m-0 flex list-none flex-col divide-y divide-[var(--border-grid)] border-t border-b border-[var(--border-grid)] p-0">
          {
            dict.experience.items.map((item) => (
              <li class="py-7 first:pt-6 last:pb-6">
                <article class="grid grid-cols-1 gap-4 md:grid-cols-12 md:gap-6">
                  <div class="md:col-span-4">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="font-mono-tech text-xs font-semibold text-[var(--text-muted)]">
                        {item.index}
                      </span>
                      {item.isCurrent && (
                        <span class="inline-flex items-center gap-1.5 rounded-[2px] border border-[var(--accent-status)] bg-[var(--state-status-bg)] px-2 py-0.5 font-mono-tech text-[0.75rem] font-semibold text-[var(--accent-status)]">
                          <span class="h-1.5 w-1.5 rounded-[1px] bg-[var(--accent-status)]" aria-hidden="true" />
                          {dict.experience.currentBadge}
                        </span>
                      )}
                    </div>
                    <p class="m-0 mt-1.5 font-mono-tech text-sm font-semibold text-[var(--text-primary)]">
                      {item.period}
                    </p>
                    <p class="m-0 mt-1 font-mono-tech text-xs text-[var(--text-muted)]">
                      {item.location}
                    </p>
                    <p class="m-0 mt-2 inline-block rounded-[2px] border border-[var(--border-grid)] bg-[var(--bg-subtle)] px-2 py-0.5 font-mono-tech text-[0.75rem] text-[var(--text-muted)]">
                      [{item.provenance}]
                    </p>
                  </div>

                  <div class="md:col-span-8">
                    <h3 class="m-0 text-lg font-semibold leading-snug text-[var(--text-primary)]">
                      {item.role}
                    </h3>
                    <p class="m-0 mt-1 text-base font-medium text-[var(--accent-primary)]">
                      {item.company}
                    </p>
                    <p class="m-0 mt-3 max-w-[68ch] text-sm leading-relaxed text-[var(--text-secondary)]">
                      {item.summary}
                    </p>
                    <ul class="m-0 mt-3 flex list-disc flex-col gap-2 pl-5 text-sm leading-relaxed text-[var(--text-secondary)]">
                      {item.highlights.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                    <ul
                      aria-label="Technologies"
                      class="m-0 mt-4 flex list-none flex-wrap gap-1.5 p-0"
                    >
                      {item.stack.map((tech) => (
                        <li class="swiss-badge">{tech}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
