---
import { PROFILE_CONSTANTS, type PortfolioDictionary } from '../data/portfolio';

interface Props {
  dict: PortfolioDictionary;
}

const { dict } = Astro.props;
const currentYear = 2026;
---

<footer class="swiss-section bg-[var(--bg-subtle)] py-10">
  <div class="swiss-container">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="m-0 font-mono-tech text-xs font-semibold text-[var(--text-primary)]">
          &copy; {currentYear} {dict.footer.copyrightText}
        </p>
        <p class="m-0 mt-1 font-mono-tech text-xs text-[var(--text-muted)]">
          {dict.footer.architectureNote} {dict.footer.timezoneNote}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a
          href={PROFILE_CONSTANTS.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="swiss-btn-secondary !min-h-[44px] !px-3 font-mono-tech !text-xs"
        >
          GitHub
        </a>
        <a
          href={PROFILE_CONSTANTS.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="swiss-btn-secondary !min-h-[44px] !px-3 font-mono-tech !text-xs"
        >
          LinkedIn
        </a>
        <a
          href={PROFILE_CONSTANTS.cvDownloadPath}
          download={PROFILE_CONSTANTS.cvDownloadFilename}
          class="swiss-btn-secondary !min-h-[44px] !px-3 font-mono-tech !text-xs"
        >
          PDF CV
        </a>
      </div>
    </div>
  </div>
</footer>
