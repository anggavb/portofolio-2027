---
import { PROFILE_CONSTANTS, type NavItem, type PortfolioDictionary } from '../data/portfolio';

interface Props {
  dict: PortfolioDictionary;
}

const { dict } = Astro.props;

const activeNavItems: NavItem[] = [...dict.header.nav];
const contactIndex = activeNavItems.findIndex((item) => item.id === 'contact');
const insertPos = contactIndex >= 0 ? contactIndex : activeNavItems.length;

if (dict.education.certifications.length > 0) {
  activeNavItems.splice(insertPos, 0, {
    id: 'certifications',
    href: '#certifications',
    label: dict.header.certificationsNavLabel,
  });
}
if (dict.education.recommendations.length > 0) {
  activeNavItems.splice(insertPos + (dict.education.certifications.length > 0 ? 1 : 0), 0, {
    id: 'recommendations',
    href: '#recommendations',
    label: dict.header.recommendationsNavLabel,
  });
}
---

<header class="sticky top-0 z-40 border-b border-[var(--border-grid)] bg-[var(--bg-canvas)]">
  <div class="swiss-container flex min-h-16 items-center justify-between gap-3 py-2">
    <a
      href={`/${dict.locale}/`}
      class="inline-flex min-h-[44px] items-center gap-2.5 text-left no-underline"
    >
      <span class="text-base font-bold tracking-tight text-[var(--text-primary)]">
        {dict.header.brandName}
      </span>
      <span
        class="hidden border-l border-[var(--border-strong)] pl-2.5 font-mono-tech text-xs font-medium text-[var(--text-muted)] sm:inline"
      >
        {dict.header.brandRole}
      </span>
    </a>

    <nav aria-label={dict.a11y.primaryNavigation} class="hidden xl:block">
      <ul class="m-0 flex list-none items-center gap-1 p-0">
        {
          activeNavItems.map((item) => (
            <li>
              <a
                href={item.href}
                data-section-nav={item.id}
                class="inline-flex min-h-[44px] items-center rounded-[3px] px-2.5 font-mono-tech text-[0.8125rem] font-medium text-[var(--text-secondary)] no-underline hover:bg-[var(--bg-subtle)] hover:text-[var(--text-primary)]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <nav
        aria-label={dict.a11y.languageSwitcherLabel}
        class="inline-flex items-center rounded-[3px] border border-[var(--border-strong)] bg-[var(--bg-surface)] p-0.5"
      >
        <a
          href="/id/"
          data-lang-link="id"
          aria-current={dict.locale === 'id' ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-[2px] px-2.5 font-mono-tech text-xs font-semibold no-underline',
            dict.locale === 'id'
              ? 'bg-[var(--text-primary)] text-[var(--bg-canvas)]'
              : 'text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]',
          ]}
        >
          ID
        </a>
        <a
          href="/en/"
          data-lang-link="en"
          aria-current={dict.locale === 'en' ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-[2px] px-2.5 font-mono-tech text-xs font-semibold no-underline',
            dict.locale === 'en'
              ? 'bg-[var(--text-primary)] text-[var(--bg-canvas)]'
              : 'text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]',
          ]}
        >
          EN
        </a>
      </nav>

      <button
        type="button"
        data-theme-cycle
        data-label-auto={dict.header.themeAuto}
        data-label-light={dict.header.themeLight}
        data-label-dark={dict.header.themeDark}
        aria-label={dict.a11y.themeSwitcherLabel}
        title={dict.header.themeCycleHint}
        class="swiss-btn-secondary hidden sm:inline-flex !px-2.5 font-mono-tech !text-xs"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <span data-theme-label class="hidden sm:inline">{dict.header.themeAuto}</span>
      </button>

      <a
        href={PROFILE_CONSTANTS.cvDownloadPath}
        download={PROFILE_CONSTANTS.cvDownloadFilename}
        class="swiss-btn-primary hidden md:inline-flex !px-3.5 !text-xs font-mono-tech"
      >
        {dict.header.downloadCvShort}
      </a>

      <button
        type="button"
        data-open-mobile-nav
        aria-controls="mobile-nav-dialog"
        class="swiss-btn-secondary xl:hidden !px-3 font-mono-tech !text-xs"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
        <span>{dict.a11y.openMenuButton}</span>
      </button>
    </div>
  </div>
</header>

<dialog
  id="mobile-nav-dialog"
  class="mobile-drawer"
  closedby="any"
  aria-labelledby="mobile-nav-title"
>
  <div class="flex items-center justify-between border-b border-[var(--border-grid)] px-4 py-3">
    <h2 id="mobile-nav-title" class="m-0 font-mono-tech text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
      {dict.a11y.mobileNavigationTitle}
    </h2>
    <form method="dialog">
      <button type="submit" class="swiss-btn-secondary !px-3 font-mono-tech !text-xs">
        {dict.a11y.closeMenuButton}
      </button>
    </form>
  </div>

  <div class="flex flex-1 flex-col justify-between overflow-y-auto p-4">
    <nav aria-label={dict.a11y.primaryNavigation}>
      <ul class="m-0 flex list-none flex-col gap-2 p-0">
        {
          activeNavItems.map((item) => (
            <li>
              <a
                href={item.href}
                data-mobile-nav-link
                class="flex min-h-[48px] items-center justify-between rounded-[3px] border border-[var(--border-grid)] bg-[var(--bg-canvas)] px-3.5 font-mono-tech text-sm font-medium text-[var(--text-primary)] no-underline hover:border-[var(--border-strong)]"
              >
                <span>{item.label}</span>
                <span aria-hidden="true" class="text-[var(--text-muted)]">-&gt;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-6 flex flex-col gap-4 border-t border-[var(--border-grid)] pt-4">
      <div>
        <p class="m-0 mb-2 font-mono-tech text-xs font-medium text-[var(--text-muted)]">
          {dict.a11y.themeSwitcherLabel}
        </p>
        <div class="grid grid-cols-3 gap-2">
          <button
            type="button"
            data-theme-set="auto"
            class="swiss-filter-btn !px-2 !text-xs"
            aria-pressed="true"
          >
            {dict.header.themeAuto}
          </button>
          <button
            type="button"
            data-theme-set="light"
            class="swiss-filter-btn !px-2 !text-xs"
            aria-pressed="false"
          >
            {dict.header.themeLight}
          </button>
          <button
            type="button"
            data-theme-set="dark"
            class="swiss-filter-btn !px-2 !text-xs"
            aria-pressed="false"
          >
            {dict.header.themeDark}
          </button>
        </div>
      </div>

      <a
        href={PROFILE_CONSTANTS.cvDownloadPath}
        download={PROFILE_CONSTANTS.cvDownloadFilename}
        class="swiss-btn-primary w-full font-mono-tech text-sm"
      >
        {dict.hero.secondaryCta}
      </a>
    </div>
  </div>
</dialog>
