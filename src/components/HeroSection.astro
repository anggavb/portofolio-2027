---
import { PROFILE_CONSTANTS, type PortfolioDictionary } from '../data/portfolio';

interface Props {
  dict: PortfolioDictionary;
}

const { dict } = Astro.props;
---

<section aria-labelledby="hero-heading" class="py-10 sm:py-14 lg:py-20">
  <div class="swiss-container">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-3">
        <p class="m-0 font-mono-tech text-xs font-semibold tracking-wider text-[var(--text-muted)]">
          {dict.hero.sectionIndex}
        </p>
        <div class="mt-4 swiss-card p-3.5">
          <div class="flex items-center gap-2">
            <span
              class="inline-block h-2.5 w-2.5 shrink-0 rounded-[1px] bg-[var(--accent-status)]"
              aria-hidden="true"
            ></span>
            <span class="font-mono-tech text-xs font-semibold uppercase tracking-wide text-[var(--accent-status)]">
              {dict.hero.currentStatusLabel}
            </span>
          </div>
          <p class="m-0 mt-2 text-sm font-semibold leading-snug text-[var(--text-primary)]">
            {dict.hero.currentRoleText}
          </p>
          <p class="m-0 mt-2 inline-block rounded-[2px] border border-[var(--border-grid)] bg-[var(--bg-subtle)] px-2 py-0.5 font-mono-tech text-[0.75rem] text-[var(--text-muted)]">
            [{dict.hero.currentRoleProvenance}]
          </p>
        </div>
      </div>

      <div class="lg:col-span-9">
        <p class="m-0 font-mono-tech text-xs font-medium tracking-wider text-[var(--accent-primary)]">
          {dict.hero.eyebrow}
        </p>
        <h1
          id="hero-heading"
          class="m-0 mt-3 text-[clamp(2rem,4.2vw,3.35rem)] font-bold leading-[1.12] tracking-[-0.03em] text-[var(--text-primary)]"
        >
          {dict.hero.headline}
        </h1>
        <p class="m-0 mt-5 max-w-[68ch] text-base leading-[1.68] text-[var(--text-secondary)] sm:text-lg">
          {dict.hero.subheadline}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="#projects" class="swiss-btn-brand">
            <span>{dict.hero.primaryCta}</span>
            <span aria-hidden="true" class="font-mono-tech">-&gt;</span>
          </a>
          <a
            href={PROFILE_CONSTANTS.cvDownloadPath}
            download={PROFILE_CONSTANTS.cvDownloadFilename}
            class="swiss-btn-secondary"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16"></path>
            </svg>
            <span>{dict.hero.secondaryCta}</span>
          </a>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-2.5 border-t border-[var(--border-grid)] pt-5">
          <a
            href={PROFILE_CONSTANTS.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="swiss-btn-secondary !min-h-[44px] !px-3.5 font-mono-tech !text-xs"
          >
            <span>GitHub: {PROFILE_CONSTANTS.githubHandle}</span>
          </a>
          <a
            href={PROFILE_CONSTANTS.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="swiss-btn-secondary !min-h-[44px] !px-3.5 font-mono-tech !text-xs"
          >
            <span>LinkedIn: /in/angga-vb</span>
          </a>
          <a
            href={`mailto:${PROFILE_CONSTANTS.email}`}
            class="swiss-btn-secondary !min-h-[44px] !px-3.5 font-mono-tech !text-xs"
          >
            <span>{PROFILE_CONSTANTS.email}</span>
          </a>
        </div>

        <dl class="m-0 mt-6 grid grid-cols-1 gap-3 border-t border-[var(--border-grid)] pt-5 sm:grid-cols-3">
          <div class=" font-mono-tech text-xs text-[var(--text-muted)]">
            <dt class="sr-only">Location</dt>
            <dd class="m-0">{dict.hero.locationLabel}</dd>
          </div>
          <div class="font-mono-tech text-xs text-[var(--text-muted)]">
            <dt class="sr-only">Experience</dt>
            <dd class="m-0">{dict.hero.experienceYearsLabel}</dd>
          </div>
          <div class="font-mono-tech text-xs text-[var(--text-muted)]">
            <dt class="sr-only">Core Stack</dt>
            <dd class="m-0">{dict.hero.coreStackLabel}</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 border-t border-[var(--border-grid)] pt-8 md:grid-cols-3">
      {
        dict.hero.pillars.map((pillar) => (
          <article class="swiss-card p-5">
            <p class="m-0 font-mono-tech text-xs font-semibold text-[var(--accent-primary)]">
              {pillar.index}
            </p>
            <h2 class="m-0 mt-2 text-lg font-semibold text-[var(--text-primary)]">
              {pillar.title}
            </h2>
            <p class="m-0 mt-1.5 font-mono-tech text-xs text-[var(--text-muted)]">
              {pillar.stack}
            </p>
            <p class="m-0 mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
              {pillar.summary}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
