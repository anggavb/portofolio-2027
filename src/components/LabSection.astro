---
import { PROFILE_CONSTANTS, type PortfolioDictionary } from '../data/portfolio';
import type { GitHubSnapshot } from '../lib/github';
import { UTC7_OFFSET_MS } from '../lib/theme';

interface Props {
  dict: PortfolioDictionary;
  snapshot: GitHubSnapshot | null;
}

const { dict, snapshot } = Astro.props;

function formatUtc7Timestamp(isoString: string, locale: 'id' | 'en'): string {
  const ms = Date.parse(isoString);
  if (Number.isNaN(ms)) return isoString;
  const shifted = new Date(ms + UTC7_OFFSET_MS);
  const yyyy = shifted.getUTCFullYear();
  const mm = String(shifted.getUTCMonth() + 1).padStart(2, '0');
  const dd = String(shifted.getUTCDate()).padStart(2, '0');
  const hh = String(shifted.getUTCHours()).padStart(2, '0');
  const min = String(shifted.getUTCMinutes()).padStart(2, '0');
  return locale === 'id'
    ? `${dd}/${mm}/${yyyy} ${hh}:${min} WIB (UTC+7)`
    : `${yyyy}-${mm}-${dd} ${hh}:${min} UTC+7`;
}
---

<section id="github-lab" aria-labelledby="lab-heading" class="swiss-section py-12 sm:py-16">
  <div class="swiss-container">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-3">
        <p class="m-0 font-mono-tech text-xs font-semibold tracking-wider text-[var(--text-muted)]">
          {dict.lab.sectionIndex}
        </p>
        <h2
          id="lab-heading"
          class="m-0 mt-2 text-[clamp(1.5rem,2.5vw,2.15rem)] font-bold leading-[1.2] tracking-[-0.02em] text-[var(--text-primary)]"
        >
          {dict.lab.title}
        </h2>
        <p class="m-0 mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
          {dict.lab.subtitle}
        </p>
      </div>

      <div class="lg:col-span-9">
        <h3 class="m-0 border-b border-[var(--border-grid)] pb-3 text-lg font-bold text-[var(--text-primary)]">
          {dict.lab.explorationsHeading}
        </h3>

        <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
          {
            dict.lab.explorations.map((item) => (
              <article class="swiss-card flex flex-col justify-between p-5">
                <div>
                  <p class="m-0 font-mono-tech text-xs font-semibold text-[var(--accent-primary)]">
                    {item.index}
                  </p>
                  <h4 class="m-0 mt-1.5 text-base font-bold text-[var(--text-primary)]">
                    {item.title}
                  </h4>
                  <p class="m-0 mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
                    {item.summary}
                  </p>
                  <ul class="m-0 mt-3.5 flex list-none flex-wrap gap-1.5 p-0">
                    {item.stack.map((tech) => (
                      <li class="swiss-badge">{tech}</li>
                    ))}
                  </ul>
                </div>

                <div class="mt-4 flex flex-wrap gap-2 border-t border-[var(--border-grid)] pt-3.5">
                  {item.repos.map((repo) => (
                    <a
                      href={repo.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="swiss-btn-secondary !min-h-[44px] !px-3 font-mono-tech !text-xs"
                    >
                      <span>{repo.label}</span>
                      <span class="visually-hidden">{dict.a11y.externalRepoNotice}</span>
                      <span aria-hidden="true">-&gt;</span>
                    </a>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <div
          class="mt-10 swiss-card p-5 sm:p-6"
          data-github-telemetry
          data-locale={dict.locale}
          data-no-desc-label={dict.lab.noDescriptionLabel}
          data-syncing-label={dict.lab.syncingStatusLabel}
          data-cached-label={dict.lab.cachedStatusLabel}
          data-external-notice={dict.a11y.externalRepoNotice}
          data-build-snapshot={snapshot ? JSON.stringify(snapshot) : ''}
        >
          <div class="flex flex-col gap-3 border-b border-[var(--border-grid)] pb-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h3 class="m-0 text-lg font-bold text-[var(--text-primary)]">
                {dict.lab.telemetryHeading}
              </h3>
              <p class="m-0 mt-1 text-xs text-[var(--text-muted)]">
                {dict.lab.telemetrySubheading}
              </p>
            </div>
            <div class="flex items-center gap-2">
              <span
                data-gh-status
                class="rounded-[2px] border border-[var(--border-grid)] bg-[var(--bg-subtle)] px-2.5 py-1 font-mono-tech text-xs text-[var(--text-muted)]"
              >
                {snapshot ? dict.lab.cachedStatusLabel : dict.lab.unavailableTitle}
              </span>
              <a
                href={PROFILE_CONSTANTS.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="swiss-btn-secondary !min-h-[44px] !px-3 font-mono-tech !text-xs"
              >
                <span>{dict.lab.viewGitHubProfileCta}</span>
                <span aria-hidden="true">-&gt;</span>
              </a>
            </div>
          </div>

          <dl class="m-0 mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="rounded-[3px] border border-[var(--border-grid)] bg-[var(--bg-canvas)] p-3.5">
              <dt class="font-mono-tech text-xs text-[var(--text-muted)]">
                {dict.lab.publicReposLabel}
              </dt>
              <dd
                data-gh-public-repos
                class="m-0 mt-1 font-mono-tech text-2xl font-bold text-[var(--text-primary)]"
              >
                {snapshot ? String(snapshot.profile.public_repos) : '--'}
              </dd>
            </div>

            <div class="rounded-[3px] border border-[var(--border-grid)] bg-[var(--bg-canvas)] p-3.5">
              <dt class="font-mono-tech text-xs text-[var(--text-muted)]">
                {dict.lab.followersLabel}
              </dt>
              <dd
                data-gh-followers
                class="m-0 mt-1 font-mono-tech text-2xl font-bold text-[var(--text-primary)]"
              >
                {snapshot ? String(snapshot.profile.followers) : '--'}
              </dd>
            </div>

            <div class="rounded-[3px] border border-[var(--border-grid)] bg-[var(--bg-canvas)] p-3.5">
              <dt class="font-mono-tech text-xs text-[var(--text-muted)]">
                {dict.lab.syncedAtLabel}
              </dt>
              <dd
                data-gh-fetched-at
                data-raw-fetched-at={snapshot ? snapshot.fetchedAt : ''}
                class="m-0 mt-1.5 font-mono-tech text-xs font-semibold text-[var(--text-primary)]"
              >
                {snapshot ? formatUtc7Timestamp(snapshot.fetchedAt, dict.locale) : '--'}
              </dd>
            </div>
          </dl>

          {snapshot ? (
            <div data-gh-repos-wrapper class="mt-5">
              <h4 class="m-0 font-mono-tech text-xs font-semibold uppercase tracking-wide text-[var(--text-muted)]">
                {dict.lab.recentNonForkHeading}
              </h4>
              <ul
                data-gh-repos-list
                class="m-0 mt-3 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2"
              >
                {snapshot.recentRepos.map((repo) => (
                  <li class="rounded-[3px] border border-[var(--border-grid)] bg-[var(--bg-canvas)] p-3.5">
                    <div class="flex items-start justify-between gap-2">
                      <a
                        href={repo.html_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-[44px] items-center font-mono-tech text-sm font-semibold text-[var(--accent-primary)] underline underline-offset-4"
                      >
                        <span>{repo.name}</span>
                        <span class="visually-hidden">{dict.a11y.externalRepoNotice}</span>
                      </a>
                      {repo.language && (
                        <span class="swiss-badge">{repo.language}</span>
                      )}
                    </div>
                    <p class="m-0 mt-1 text-xs leading-relaxed text-[var(--text-secondary)]">
                      {repo.description ?? dict.lab.noDescriptionLabel}
                    </p>
                    <p class="m-0 mt-2 font-mono-tech text-[0.75rem] text-[var(--text-muted)]">
                      pushed: {repo.pushed_at.slice(0, 10)}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <div
              data-gh-unavailable
              class="mt-5 rounded-[3px] border border-[var(--border-strong)] bg-[var(--bg-canvas)] p-4"
            >
              <p class="m-0 text-sm font-semibold text-[var(--text-primary)]">
                {dict.lab.unavailableTitle}
              </p>
              <p class="m-0 mt-1 text-sm text-[var(--text-secondary)]">
                {dict.lab.unavailableBody}
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
